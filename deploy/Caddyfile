# Caddy: die "Eingangstür" des Servers – verteilt Anfragen nach Adresse.
#
#   https://API_HOST     (z. B. api.botrics.de)    → Backend         (für die App)
#   https://ADMIN_HOST   (z. B. admin.botrics.de)  → Admin-Dashboard + /api
#   http://localhost:8088 (Heimnetz / ohne Tunnel) → Admin-Dashboard + /api
#
# Mit Cloudflare-Tunnel übernimmt CLOUDFLARE die Verschlüsselung (HTTPS). Zwischen cloudflared und
# Caddy läuft einfaches HTTP im internen Docker-Netz – darum "http://" vor den Adressen
# (sonst würde Caddy selbst versuchen, Zertifikate zu holen).

{
	servers {
		# Anfragen aus dem internen Netz (cloudflared-Container) dürfen uns sagen, was der
		# Besucher eigentlich aufgerufen hat (https, echte IP, Hostname). Ohne das hielte das
		# Backend jede Verbindung für unverschlüsseltes HTTP → falsche Rückleitung nach Stripe.
		trusted_proxies static private_ranges
	}
}

(sicherheit) {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

# Nur für Adressen, die AUSSCHLIESSLICH über HTTPS (Cloudflare) erreichbar sind:
# Browser merken sich ein Jahr lang "nur noch HTTPS".
(nur_https) {
	header Strict-Transport-Security "max-age=31536000"
}

# Content-Security-Policy fürs Dashboard: Der Browser führt NUR Skripte von dieser Adresse aus.
# Selbst wenn es jemand schaffen sollte, fremden Code in die Seite zu schmuggeln, läuft er nicht –
# und kann so z. B. den Login-Schlüssel nicht stehlen.
(csp_dashboard) {
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
}

(dashboard_und_api) {
	handle_path /api/* {
		reverse_proxy api:3000 {
			# Dem Backend sagen, dass es von außen unter /api erreichbar ist
			header_up X-Forwarded-Prefix /api
		}
	}
	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
}

# --- App-API: https://api.botrics.de (Backend direkt, ohne /api davor) ---
http://{$API_HOST:api.example.invalid} {
	import sicherheit
	import nur_https
	# Die API liefert (fast) nur JSON – Browser sollen hier gar nichts ausführen
	header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'"

	# Admin- und Entwickler-Funktionen gibt es hier NICHT – nur über admin.botrics.de,
	# das zusätzlich von Cloudflare Access geschützt ist
	@gesperrt path /admin /admin/* /dev /dev/*
	respond @gesperrt "Not found" 404

	reverse_proxy api:3000 {
		# Nicht vom Besucher vorgeben lassen
		header_up -X-Forwarded-Prefix
	}
}

# --- Admin-Dashboard: https://admin.botrics.de (zusätzlich mit Cloudflare Access schützen!) ---
http://{$ADMIN_HOST:admin.example.invalid} {
	import sicherheit
	import nur_https
	import csp_dashboard
	import dashboard_und_api
}

# --- Alles andere: lokal / Heimnetz (http://localhost:8088) oder ein eigener Server mit
#     Domain (SITE_ADDRESS=radpark.example.com → Caddy holt dann selbst ein HTTPS-Zertifikat) ---
{$SITE_ADDRESS::80} {
	import sicherheit
	import csp_dashboard
	import dashboard_und_api
}
