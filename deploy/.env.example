# Kopieren nach deploy/.env und ausfüllen. deploy/.env kommt NIE ins Git!
# Sichere Zufalls-Passwörter erzeugen:  openssl rand -base64 24

# Deine echte E-Mail-Adresse – wird Admin (Admin-Dashboard). NIE eine erfundene Adresse verwenden!
ADMIN_EMAIL=

POSTGRES_PASSWORD=
MQTT_API_PASSWORD=
MQTT_STATION_PASSWORD=
MQTT_STATIONS=BER-001,BER-002,BER-003

# Stripe – NUR Testschlüssel (sk_test_…). Live-Schlüssel werden abgelehnt.
STRIPE_SECRET_KEY=
# Stripe-Webhook-Geheimnis (whsec_…) – erst nötig, wenn der Server öffentlich erreichbar ist
STRIPE_WEBHOOK_SECRET=

# E-Mail. Leer = Mailpit (Test-Postfach, http://localhost:8025). Auf dem Server z. B.:
# SMTP_URL=smtp://benutzer:passwort@smtp-relay.brevo.com:587
SMTP_URL=
MAIL_FROM=RadPark <noreply@radpark.local>

# Erst mit Cloudflare-Tunnel setzen: CLIENT_IP_HEADER=cf-connecting-ip
CLIENT_IP_HEADER=

# Simulator-Knöpfe in der App erlauben (true, solange keine echten Ständer angeschlossen sind)
SIMULATOR_CONTROL=true

# --- Cloudflare-Tunnel ---
# Adressen, unter denen App und Dashboard öffentlich erreichbar sind
API_HOST=
ADMIN_HOST=
# Token aus dem Cloudflare-Dashboard (Zero Trust → Networks → Tunnels) – geheim wie ein Passwort!
CLOUDFLARE_TUNNEL_TOKEN=
# "tunnel" = cloudflared-Container mitstarten (erst setzen, wenn der Token eingetragen ist)
COMPOSE_PROFILES=
# Mit Tunnel: lokalen Zugang nur von diesem Rechner erlauben
HTTP_BIND=0.0.0.0

# Adresse: ":80" = lokal per HTTP. Auf dem Server: deine Domain, z. B. radpark.example.com → automatisch HTTPS
SITE_ADDRESS=:80
HTTP_PORT=8088
MQTT_PORT=1884
MAILPIT_PORT=8025
