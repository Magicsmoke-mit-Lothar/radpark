# Kopiere diese Datei nach ".env" (cp .env.example .env). Die .env wird NICHT ins Git eingecheckt.
DATABASE_URL=postgres://radpark:radpark@localhost:5432/radpark
MQTT_URL=mqtt://localhost:1883
PORT=3000
LOG_LEVEL=info

# Entwickler-Endpunkte unter /dev/* (ohne Login!) – nur lokal auf true setzen
DEV_ROUTES=true

# Reservierung ohne eingestelltes Rad wird nach so vielen Sekunden abgebrochen
RESERVATION_TIMEOUT_SECONDS=120

# --- Bezahlung (NUR Stripe-TESTMODUS, kein Echtgeld) ---
# Testschlüssel aus dem Stripe-Dashboard → Entwickler → API-Schlüssel (Testmodus).
# Leer lassen = interne Testgutschrift ohne Stripe.
STRIPE_SECRET_KEY=
# Mindestguthaben in Cent, um einen Parkvorgang zu starten
MIN_START_BALANCE_CENTS=100

# Feinere Schalter (Standard: wie DEV_ROUTES). Auf einem Server: beide false bzw. bewusst gesetzt.
# DEV_LOGIN_CODES=true     # Login-Code in der Antwort (statt nur per E-Mail)
# SIMULATOR_CONTROL=true   # 🛠-Simulator-Knöpfe in der App
# SMTP_URL=                # E-Mail-Versand, z. B. smtp://user:pass@smtp.anbieter.de:587
